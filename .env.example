# LLM provider: auto | llamacpp | deepseek | anthropic
LLM_PROVIDER=auto

# llama.cpp (llama-server)
LLAMA_CPP_BASE_URL=http://localhost:8080
LLAMA_CPP_MODEL=qwen3-8b

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Agent
DEFAULT_MODE=ask
POLICY_FILE=config/agent.yaml
LOG_LEVEL=INFO

# Optional: force keyword-only planner (no LLM hop)
# PLANNER_KEYWORD_ONLY=false

# LangSmith (optional observability — opt-in)
# pip install -e ".[tracing]"
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=graph-agent
# LANGSMITH_WORKSPACE_ID=
